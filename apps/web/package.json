{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:design-assets": "bun scripts/sync-design-assets.ts",
    "optimize:design-assets": "bun scripts/optimize-design-assets.ts",
    "build:search-index": "bun scripts/build-search-index.ts",
    "predev": "bun run sync:design-assets && fumadocs-mdx && bun run build:search-index",
    "dev": "next dev --port 3003",
    "prebuild": "bun run sync:design-assets",
    "build": "fumadocs-mdx && bun run build:search-index && next build",
    "build:open-next": "bun run sync:design-assets && open-next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "check-types": "fumadocs-mdx && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.59",
    "@mastra/ai-sdk": "^1.7.2",
    "@orama/orama": "^3.1.18",
    "@repo/content": "workspace:*",
    "@repo/ds": "workspace:*",
    "@repo/intl": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@uidotdev/usehooks": "^2.4.1",
    "@xstate/react": "^6.1.0",
    "ai": "^7.0.56",
    "fumadocs-core": "^16.11.5",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-ui": "^16.11.5",
    "lenis": "^1.3.25",
    "lucide-react": "^1.25.0",
    "motion": "^13.1.1",
    "next": "16.3.1",
    "next-intl": "^4.13.3",
    "nextjs-toploader": "^3.9.17",
    "posthog-js": "^1.415.7",
    "react": "19.2.8",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "xstate": "^5.32.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@opennextjs/aws": "4.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
