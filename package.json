{
  "name": "oc2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "deploy": "bunx sst deploy --stage production",
    "dev": "bunx sst dev --stage local",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "sso": "aws sso login --sso-session=sinlongchow"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "sst": "4.17.1"
  }
}
