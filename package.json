{
  "name": "oc2",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "bunx sst dev --stage local",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mts,json}\"",
    "lint": "turbo run lint",
    "sso": "aws sso login --sso-session=sinlongchow",
    "deploy": "bunx sst deploy --stage production",
    "deploy:dev": "bunx sst deploy --stage dev",
    "deploy:production": "bun run deploy && bun run verify:production",
    "verify:production": "node node_modules/playwright/cli.js install chromium && node --experimental-strip-types scripts/verify-production.mts",
    "a11y:smoke": "node node_modules/playwright/cli.js install chromium && node --experimental-strip-types scripts/a11y-smoke.mts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,md,mts,json}": "prettier --write"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@repo/infra": "workspace:*",
    "sst": "4.17.1"
  }
}
